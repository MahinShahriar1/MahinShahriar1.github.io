<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer">
    <div class="card hoverable d-inline-block" style="max-width: 260px;">
      <div style="height: 180px; overflow: hidden; background: #111827;">
        <img
          src="{{ '/assets/img/prof_pic.jpg' | relative_url }}"
          alt="{{ include.username }}"
          style="width: 100%; height: 100%; object-fit: cover;"
        >
      </div>

      <div class="card-body">
        <h5 class="card-title mb-0">{{ include.username }}</h5>
      </div>
    </div>
  </a>
</div>
