{% assign repo_url = include.repository | split: '/' %}
{% assign owner = repo_url[0] %}
{% assign repo = repo_url[1] %}

<div class="repo p-3">
  <a href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer">
    <div class="card hoverable h-100">
      <div class="card-body">
        <h5 class="card-title mb-1">{{ repo }}</h5>
        <p class="card-text text-muted mb-0">{{ owner }}/{{ repo }}</p>
      </div>
    </div>
  </a>
</div>
