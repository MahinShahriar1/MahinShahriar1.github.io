{% assign repo_parts = include.repository | split: '/' %}
{% assign owner = repo_parts[0] %}
{% assign repo_name = repo_parts[1] %}
{% assign repo_img = site.data.repository_images[repo_name] | default: 'lv-grid-visibility.jpg' %}

<div class="repo p-2">
  <a href="https://github.com/{{ include.repository }}" target="_blank" rel="noopener noreferrer">
    <div class="card hoverable h-100">
      <div style="height: 155px; overflow: hidden; background: #111827;">
        <img
          src="{{ '/assets/img/' | append: repo_img | relative_url }}"
          alt="{{ repo_name }}"
          style="width: 100%; height: 100%; object-fit: cover;"
        >
      </div>

      <div class="card-body">
        <h5 class="card-title mb-1">{{ repo_name | replace: '_', ' ' | replace: '-', ' ' }}</h5>
        <p class="card-text text-muted mb-0">{{ owner }}/{{ repo_name }}</p>
      </div>
    </div>
  </a>
</div>
