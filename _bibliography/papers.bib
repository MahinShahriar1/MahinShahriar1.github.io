  preview={ANN.gif},
  bibtex_show={true},
  abstract={Accurate load flow analysis is essential for power system studies, as it ensures the system's adaptability to dynamic operating conditions, efficiency, and stability. This paper provides a comparative study using an Artificial Neural Network (ANN) model to estimate load flow solutions and compares the results with the Newton-Raphson method.}
}

