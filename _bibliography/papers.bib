@INPROCEEDINGS{11013912,
  author={Shahriar, Mahin and Ghosh, Madhusudan and Chowdhury, Abdul Hasib},
  booktitle={2025 International Conference on Electrical, Computer and Communication Engineering (ECCE)}, 
  title={Detection and Classification of Transmission Line Faults Using Convolutional Neural Networks}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Detecting and classifying faults in transmission lines are essential for ensuring power system stability and reliability. This paper introduces a standard method utilizing Convolutional Neural Networks (CNNs) to improve the precision of fault categorization. A 220 kV, 200 km transmission line model is used to simulate various fault scenarios, including single line-to-ground faults (AG, BG, CG), line-to-line faults (AB, BC, CA), double line-to-ground faults (ABG, BCG, CAG), and three-phase faults (ABCG). Voltage signals generated under these fault conditions are encoded into two-dimensional Gramian Angular Summation Field (GASF) images. A custom CNN architecture is developed, incorporating convolutional layers, pooling layers, and fully connected layers with ReLU and Softmax activation functions. Additionally, several pre-trained CNN models are modified using transfer learning and fine-tuning techniques to classify faults. The proposed CNN model attains an exceptional accuracy of 90-93%, surpassing pre-trained models such as ResNet, ConvNext, EfficientNet, etc. This study emphasizes the benefits of employing image-based representations of time-series data and illustrates the significance of deep learning for reliable transmission line fault detection across varying parameters. The comparative analysis with pre-trained architectures further substantiates the proposed model’s reliability and importance.},
  keywords={Analytical models;Power transmission lines;Accuracy;Computational modeling;Computer network reliability;Transfer learning;Computer architecture;Voltage;Power system reliability;Convolutional neural networks;Transmission Line Fault Detection;Power System Stability;Convolutional Neural Networks (CNNs);Gramian Angular Summation Field (GASF);Pre-Trained Models;Transfer Learning;Fault Diagnosis Techniques},
  doi={10.1109/ECCE64574.2025.11013912},
  ISSN={},
  month={Feb},}


@INPROCEEDINGS{11014048,
  author={Shahriar, Mahin and Ali, Mohammad and Chowdhury, Abdul Hasib},
  booktitle={2025 International Conference on Electrical, Computer and Communication Engineering (ECCE)}, 
  title={Comparative Load Flow Analysis Using Artificial Neural Network and the Newton-Raphson Method}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Accurate load flow analysis is essential for power system studies, as it ensures the system’s adaptability to dynamic operating conditions, efficiency, and stability. Although the Newton-Raphson algorithm and other conventional methods are frequently employed due to their quadratic convergence and robustness, they encounter difficulties in accommodating the real-time demands and non-linearities of contemporary power systems. This paper provides a comparative study that employs an Artificial Neural Network (ANN) model to measure load flow solutions, thereby enhancing adaptability to evolving load patterns and reducing dependence on iterative calculations. The Newton-Raphson method was employed on the IEEE-4 bus system to generate the dataset for the ANN’s training. Subsequently, the ANN was trained to calculate system variables based on load inputs. The Newton-Raphson results were compared to the calculation from the ANN model, with an emphasis on error metrics, computational efficiency, and accuracy. The ANN model effectively replicated the load flow results with minimal deviations, demonstrating its potential for real-time applications and the ability to manage complex, nonlinear relationships. The intersection of classical power system analysis methods and deep learning architectures is illustrated in this study, which underscores the latter’s advantages in computational efficiency and adaptability to the emergent challenges in modern power grids.},
  keywords={Deep learning;Accuracy;Computational modeling;Artificial neural networks;Power system stability;Mathematical models;Computational efficiency;Newton method;Load modeling;Load flow analysis;Load Flow Analysis;Newton-Raphson Method;Deep Learning;IEEE 4 Bus System;Artificial Neural Network (ANN);Power System Stability;Computational Efficiency},
  doi={10.1109/ECCE64574.2025.11014048},
  ISSN={},
  month={Feb},}

@INPROCEEDINGS{11013779,
  author={Asad, Dewan Mohammad and Shahriar, Mahin and Chowdhury, Abdul Hasib},
  booktitle={2025 International Conference on Electrical, Computer and Communication Engineering (ECCE)}, 
  title={Load Forecasting for Dhaka City Using RNN, LSTM, and GRU Architectures with Meteorological and Temporal Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper develops a machine learning model to predict the daily maximum load demand in megawatts (MW) for Dhaka city. By leveraging historical time-series data alongside meteorological and temporal factors, the model employs advanced Recurrent Neural Network (RNN) architectures, including Long Short-Term Memory (LSTM) and Gated Recurrent Unit (GRU) layers. These architectures are crucial for capturing both the short-term fluctuations and long-term trends in electricity demand. Our dataset integrates critical weather parameters such as temperature, humidity, wind speed, and precipitation, as well as significant temporal factors like government holidays, which are known to affect electricity consumption patterns significantly. Through meticulous data pre-processing, which includes scaling, feature engineering, and the application of a sliding window technique, our model can recognize intricate patterns in the data. We incorporate techniques such as batch normalization and dropout to prevent overfitting and enhance the model’s training efficiency. The results demonstrate the model’s capability to deliver highly precise load forecasts, which are essential for utility companies in planning resources, reducing operational costs, and improving overall energy management in Dhaka. This paper highlights the creation of a specialized dataset and a robust deep learning model, offering significant contributions to the enhancement of modern electrical power management systems.},
  keywords={Load forecasting;Electricity;Urban areas;Government;Humidity;Computer architecture;Predictive models;Data models;Long short term memory;Load modeling;Load forecasting;Historical time-series data;Recurrent Neural Networks (RNN);Long Short-Term Memory (LSTM);Gated Recurrent Unit (GRU);Meteorological factors;Electricity demand},
  doi={10.1109/ECCE64574.2025.11013779},
  ISSN={},
  month={Feb},}


@inproceedings{10.1145/3744255.3811721,
author = {Shahriar, Mahin and Islam, Md Zahidul and Zhang, Wentao and Lin, Yuzhang},
title = {Making Low-Voltage Networks Granularly Visible: Strategic Metering and Data-Driven Estimation via Graph Analytics and Learning},
year = {2026},
isbn = {9798400720116},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3744255.3811721},
doi = {10.1145/3744255.3811721},
abstract = {High penetration of volatile distributed energy resources (DERs) has increased the need for voltage monitoring in low-voltage (LV) distribution networks. While high-reporting-rate smart meters (HRRSMs) can capture high-resolution voltage magnitudes, their deployment is constrained by cost limits. This paper proposes a unified learning-based framework that enables near-real-time customer voltage visibility using a sparse deployment of HRRSMs integrated with existing advanced metering infrastructure. A correlation-driven graph construction combined with community detection is used to determine budget-aware, strategic HRRSM placement. A modified edge-weighted GraphSAGE model is then developed to infer high-resolution voltage profiles at nodes equipped with conventional smart meters with low-resolution measurements. Simulation results on a three-phase unbalanced distribution network demonstrate that the proposed approach accurately reconstructs granular voltage trajectories while maintaining low error levels across all phases, effectively bridging the temporal resolution gap without requiring a larger number of HRRSMs.},
booktitle = {Proceedings of the 17th ACM International Conference on Future and Sustainable Energy Systems},
pages = {726–733},
numpages = {8},
keywords = {Power distribution networks, high-rate smart meters, voltage inference, graph neural networks, GraphSAGE, community detection},
location = {
},
series = {E-Energy '26}
}
